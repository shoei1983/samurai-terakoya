      "source": [
        "# 14章課題　変数スコープを正しく使おう\n",
        "# 上と比較するためこっちに記載！\n",
        "\n",
        "\"\"\"\n",
        "以下のコードを実行するとスコープに関するエラーが発生します。\n",
        "エラーを修正して、正しく計算結果が出力されるようにしてください。\n",
        "\"\"\"\n",
        "price1 = 100\n",
        "price2 = 200\n",
        "tax = 1.1\n",
        "\n",
        "def total():\n",
        "\n",
        "    return price1 + price2\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "print (total() * tax)\n",
        "\n"
      ]
    }
  ],
